#!/usr/bin/env bash
# parc-meta-check — garde-fou anti-drift des sous-modules du méta-repo POULIDOR.
#
# Détecte et rend visibles immédiatement les trois dérives possibles :
#   1. Pointeur de sous-module : le HEAD checkouté diffère du SHA épinglé par
#      le méta-repo (release sous-module poussée sans bump méta — incident
#      HUBsocle 06/11/2026 : 2.34.0 poussée, pointeur méta oublié 2 jours).
#   2. Contenu non commité à l'intérieur d'un sous-module (WIP abandonné sur
#      le checkout principal — pattern incident HUB_base 17/09/2026).
#   3. Agents actifs dans les registres .worktrees/_agents/ de chaque
#      sous-module (collision possible avant release).
#
# Usage : bash scripts/parc-meta-check
# Exit : 0 = propre · 1 = au moins une anomalie (à utiliser avant toute
#        release méta et en début de session d'agent).

set -u

cd "$(git rev-parse --show-toplevel 2>/dev/null || echo .)" || exit 1

issues=0

section() { printf '\n=== %s ===\n' "$1"; }
flag()    { printf '⚠️  %s\n' "$1"; issues=$((issues + 1)); }
ok()      { printf '✅ %s\n' "$1"; }

section "Drift de pointeur de sous-module"

# Chaque sous-module déclaré dans .gitmodules
while IFS= read -r sub; do
    [ -z "$sub" ] && continue
    if [ ! -d "$sub/.git" ] && [ ! -f "$sub/.git" ]; then
        printf 'ℹ️  %-22s non initialisé (info, pas une anomalie)\n' "$sub"
        continue
    fi

    # 1. Pointeur : SHA épinglé par le méta vs HEAD checkouté
    pinned="$(git ls-tree HEAD -- "$sub" 2>/dev/null | awk '{print $3}')"
    head_sha="$(git -C "$sub" rev-parse HEAD 2>/dev/null)"
    branch="$(git -C "$sub" branch --show-current 2>/dev/null)"
    branch="${branch:-détaché}"

    if [ -n "$pinned" ] && [ "$pinned" != "$head_sha" ]; then
        flag "[$sub] DRIFT de pointeur : méta épinglé $pinned ≠ HEAD $head_sha ($branch)"
        # Le HEAD local est-il poussé ? (drift = release méta en attente)
        ahead="$(git -C "$sub" log --oneline "origin/${branch}".."${branch}" 2>/dev/null | wc -l)"
        if [ "${ahead:-0}" -gt 0 ]; then
            flag "[$sub] ${ahead} commit(s) locaux NON poussé(s) vers origin/${branch} — à pousser ou reprendre avant bump méta"
        fi
    else
        ok "[$sub] pointeur aligné ($branch @ $(printf '%.12s' "$head_sha"))"
    fi

    # 2. Contenu non commité à l'intérieur du sous-module
    dirty="$(git -C "$sub" status --porcelain 2>/dev/null | wc -l)"
    if [ "${dirty:-0}" -gt 0 ]; then
        flag "[$sub] ${dirty} fichier(s) NON commité(s) dans le checkout principal (WIP ?)"
        git -C "$sub" status --porcelain 2>/dev/null | head -5 | sed 's/^/      /'
    fi

    # 3. Registre d'agents du sous-module : agents encore actifs
    reg="$sub/.worktrees/_agents/registry.json"
    if [ -f "$reg" ]; then
        active="$(python3 -c "
import json,sys
try:
    r=json.load(open('$reg'))
    print(', '.join(a['branch'] for a in r.get('agents',[]) if a.get('status')=='active'))
except Exception as e:
    print('illisible: %s' % e)
" 2>/dev/null)"
        if [ -n "$active" ]; then
            flag "[$sub] agent(s) ACTIF(S) dans le registre : $active"
        fi
    fi
done < <(git config --file .gitmodules --get-regexp 'submodule\..*\.path' 2>/dev/null | awk '{print $2}')

section "Registre d'agents du méta-repo"

reg=".worktrees/_agents/registry.json"
if [ -f "$reg" ]; then
    active="$(python3 -c "
import json
try:
    r=json.load(open('$reg'))
    print(', '.join(a['branch'] for a in r.get('agents',[]) if a.get('status')=='active'))
except Exception as e:
    print('illisible: %s' % e)
" 2>/dev/null)"
    if [ -n "$active" ]; then
        flag "[méta] agent(s) ACTIF(S) : $active"
    else
        ok "[méta] aucun agent actif"
    fi
else
    printf 'ℹ️  [méta] pas de registre (normal si jamais utilisé)\n'
fi

section "Bilan"

if [ "$issues" -eq 0 ]; then
    ok "Aucune dérive détectée — release méta possible"
    exit 0
fi
printf '⚠️  %d anomalie(s) — à traiter AVANT toute release méta\n' "$issues"
exit 1
