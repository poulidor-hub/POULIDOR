# =====================================================================
# POULIDOR — Secrets API IA — TEMPLATE (documentation)
#
# Ce fichier .example EST committé (servant de doc : quelles variables
# l'écosystème POULIDOR attend). Le fichier réel est .secrets (gitignoré,
# à remplir avec les vraies clés).
#
# Mise en place :
#   cp .secrets.example .secrets
#   # éditer .secrets avec les vraies valeurs
#   chmod 600 .secrets
#
# Le sourcing est automatique via ~/.bashrc :
#   [ -f ~/MyCOMPANY/HUB_stack/POULIDOR/.secrets ] && source ~/MyCOMPANY/HUB_stack/POULIDOR/.secrets
#
# Les outils (opencode via {env:VAR}, Claude Code, codewhale, etc.)
# récupèrent les variables depuis l'environnement shell.
# =====================================================================

# ============================================================
# CONFIG ACTIVE — Anthropic via proxy DeepSeek
# (Claude Code parle au proxy DeepSeek qui traduit le protocole Anthropic)
# ============================================================
export ANTHROPIC_BASE_URL="https://..."          # URL du proxy DeepSeek
export ANTHROPIC_AUTH_TOKEN="sk-..."             # clé DeepSeek (sk-...)
export ANTHROPIC_MODEL="..."
export ANTHROPIC_DEFAULT_OPUS_MODEL="..."
export ANTHROPIC_DEFAULT_SONNET_MODEL="..."
export ANTHROPIC_DEFAULT_HAIKU_MODEL="..."
export CLAUDE_CODE_SUBAGENT_MODEL="..."
export CLAUDE_CODE_EFFORT_LEVEL="..."

# ============================================================
# ALTERNATIVE (commentée) — Anthropic direct (API officielle)
# Décommenter ce bloc + commenter le bloc ci-dessus pour basculer
# du proxy DeepSeek vers l'API Anthropic officielle.
# ============================================================
# export ANTHROPIC_AUTH_TOKEN="sk-ant-..."
# export ANTHROPIC_MODEL="..."
# export ANTHROPIC_DEFAULT_OPUS_MODEL="..."
# export ANTHROPIC_DEFAULT_SONNET_MODEL="..."
# export ANTHROPIC_DEFAULT_HAIKU_MODEL="..."
# export CLAUDE_CODE_SUBAGENT_MODEL="..."
# export CLAUDE_CODE_EFFORT_LEVEL="..."

# ============================================================
# DeepSeek natif (codewhale / docker)
# ============================================================
export DEEPSEEK_API_KEY="sk-..."

# ============================================================
# Z_AI / Zen — opencode MCP (zai-mcp-server dans opencode.json)
# ============================================================
export Z_AI_API_KEY="sk-..."
