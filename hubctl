#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKG_DIR="$ROOT_DIR/hubctl_cli"
VENV="$PKG_DIR/.venv"
PY="$VENV/bin/python"
STAMP="$VENV/.deps-installed"

if [ ! -x "$PY" ]; then
  echo "→ Création de l'environnement Python (hubctl_cli/.venv)…"
  python3 -m venv "$VENV"
fi

if [ ! -f "$STAMP" ] || [ "$PKG_DIR/requirements.txt" -nt "$STAMP" ]; then
  echo "→ Installation des dépendances…"
  "$VENV/bin/pip" install --quiet --upgrade pip >/dev/null
  "$VENV/bin/pip" install --quiet -r "$PKG_DIR/requirements.txt"
  touch "$STAMP"
fi

cd "$ROOT_DIR"
exec "$PY" -m hubctl_cli "$@"
