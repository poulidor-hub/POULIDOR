#!/usr/bin/env bash
# Wrapper POULIDOR → hubctl_src/hubctl
# Initialise automatiquement le sous-module hubctl_src si nécessaire.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_HUBCTL="$ROOT_DIR/hubctl_src/hubctl"

# Si le sous-module n'est pas initialisé, le faire maintenant.
if [ ! -f "$REAL_HUBCTL" ]; then
    echo "→ Initialisation du sous-module hubctl_src…"
    cd "$ROOT_DIR"
    if ! git submodule update --init hubctl_src; then
        echo "✗ Échec de l'initialisation du sous-module hubctl_src." >&2
        echo "  Essaye : git submodule update --init --recursive" >&2
        exit 1
    fi
    echo "✓ Sous-module initialisé."
fi

exec "$REAL_HUBCTL" "$@"
