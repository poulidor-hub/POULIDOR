{
  "$schema": "https://opencode.ai/config.json",
  "share": "auto",
  "default_agent": "jellycode",
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git#8ca22dba9a94f28898bbce59f2537ff4d87c747d"
  ],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "hub": {
      "type": "local",
      "command": ["bash", "-c", "cd hub-mcp && exec python3 -m hub_mcp.server"],
      "enabled": false
    },
    "zai-mcp-server": {
      "type": "local",
      "command": ["npx", "-y", "@z_ai/mcp-server"],
      "enabled": false,
      "environment": {
        "Z_AI_API_KEY": "{env:Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    }
  }
}
